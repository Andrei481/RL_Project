{
  "dqn_per_kangaroo": {
    "agent": [{
      "name": "DQN",
      "algorithm": {
        "name": "DQN",
        "action_pdtype": "Argmax",
        "action_policy": "boltzmann",
        "explore_var_spec": {
          "name": "linear_decay",
          "start_val": 5.0,
          "end_val": 0.5,
          "start_step": 0,
          "end_step": 500000
        },
        "gamma": 0.99,
        "target_net_update_frequency": 10000,
        "training_frequency": 4,
        "training_start_step": 50000,
        "training_batch_iter": 3,
        "training_iter": 3
      },
      "memory": {
        "name": "PrioritizedReplay",
        "max_size": 500000,
        "batch_size": 32,
        "alpha": 0.6, 
        "beta_spec": {    
          "name": "linear_decay",
          "start_val": 0.4,
          "end_val": 1.0,
          "start_step": 0,
          "end_step": 1000000
        },
        "epsilon": 1e-6,
        "use_cer": false
      },
      "net": {
        "type": "ConvNet",
        "shared": true,
        "conv_hid_layers": [
          [32, 8, 4, 0, 1],
          [64, 4, 2, 0, 1],
          [64, 3, 1, 0, 1]
        ],
        "fc_hid_layers": [512],
        "hid_layers_activation": "relu",
        "init_fn": "orthogonal_",
        "normalize": true,
        "batch_norm": false,
        "clip_grad_val": 1.0,
        "loss_spec": { "name": "SmoothL1Loss" },
        "optim_spec": {
          "name": "Adam",
          "lr": 1e-4
        },
        "lr_scheduler_spec": null,
        "gpu": false
      }
    }],
    "env": [{
      "name": "Kangaroo-v0",
      "frame_op": "concat",
      "frame_op_len": 4,
      "reward_scale": "sign",
      "num_envs": 8,
      "max_t": null,
      "max_frame": 1000000
    }],
    "body": {
      "product": "outer",
      "num": 1
    },
    "meta": {
      "distributed": false,
      "eval_frequency": 25000,
      "log_frequency": 10000,
      "rigorous_eval": 1,
      "max_session": 1,
      "max_trial": 1
    }
  }
}
